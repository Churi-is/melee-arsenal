#!/usr/bin/env bash
# melee — Developer & deployment CLI for Melee Arsenal (Borderlands 2 PythonSDK Mod)
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_KIT="$REPO_ROOT/build/inkblade_kit"
COOKED_REL="build/WillowGame/CookedPCConsole"
BUILD_MANIFEST="$REPO_ROOT/build/inkblade_compiled_manifest.json"
MOD_REL="sdk_mods/melee_arsenal"
BL2_CACHE_FILE="$REPO_ROOT/.bl2_dir"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_RESET=$'\033[0m'
else
  C_BOLD=""; C_DIM=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_RESET=""
fi

info()  { printf "%s==>%s %s%s%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"; }
ok()    { printf "%s✓%s %s\n" "$C_GREEN" "$C_RESET" "$*"; }
warn()  { printf "%s!%s %s\n" "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()   { printf "%s✗ Error:%s %s\n" "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

pick_python() {
  if [ -n "${PYTHON:-}" ]; then
    printf "%s\n" "$PYTHON"
  elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    printf "%s\n" "$REPO_ROOT/.venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    command -v python3
  else
    die "python3 not found in PATH."
  fi
}

mod_version() {
  local py
  py="$(pick_python)"
  "$py" - "$REPO_ROOT/$MOD_REL/__init__.py" <<'PY'
import re, sys
from pathlib import Path
txt = Path(sys.argv[1]).read_text(encoding="utf-8")
m = re.search(r'^__version__\s*=\s*["\']([^"\']+)["\']', txt, re.M)
print(m.group(1) if m else "0.0.0")
PY
}

ensure_gitignored() {
  local entry="$1"
  local gi="$REPO_ROOT/.gitignore"
  if [ -f "$gi" ] && ! grep -qxF "$entry" "$gi"; then
    printf "%s\n" "$entry" >> "$gi"
  fi
}

is_valid_bl2_dir() {
  local d="$1"
  [ -d "$d" ] && [ -d "$d/WillowGame/CookedPCConsole" ]
}

has_pythonsdk_markers() {
  local d="$1"
  [ -d "$d/sdk_mods" ] || [ -d "$d/Binaries/Win32/Plugins" ] || [ -f "$d/Binaries/Win32/Borderlands2.exe" ]
}

detect_bl2_dir() {
  local override="${1:-}"
  if [ -n "$override" ]; then
    is_valid_bl2_dir "$override" || die "Not a valid Borderlands 2 directory (missing WillowGame/CookedPCConsole): $override"
    ensure_gitignored ".bl2_dir"
    printf "%s\n" "$override" > "$BL2_CACHE_FILE"
    printf "%s\n" "$override"
    return 0
  fi

  if [ -n "${BL2_DIR:-}" ]; then
    is_valid_bl2_dir "$BL2_DIR" || die "BL2_DIR is set but missing WillowGame/CookedPCConsole: $BL2_DIR"
    printf "%s\n" "$BL2_DIR"
    return 0
  fi

  if [ -f "$BL2_CACHE_FILE" ]; then
    local cached
    cached="$(head -n 1 "$BL2_CACHE_FILE" | sed 's/[[:space:]]*$//')"
    if [ -n "$cached" ] && is_valid_bl2_dir "$cached"; then
      printf "%s\n" "$cached"
      return 0
    fi
  fi

  local -a candidates=()
  local -a steam_roots=(
    "$HOME/.steam/steam"
    "$HOME/.local/share/Steam"
    "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    "$HOME/Library/Application Support/Steam"
  )

  local sr vdf lib_path
  for sr in "${steam_roots[@]}"; do
    candidates+=("$sr/steamapps/common/Borderlands 2")
    vdf="$sr/steamapps/libraryfolders.vdf"
    if [ -f "$vdf" ]; then
      while IFS= read -r lib_path; do
        [ -n "$lib_path" ] && candidates+=("$lib_path/steamapps/common/Borderlands 2")
      done < <(sed -n 's/.*"path"[[:space:]]*"\([^"]*\)".*/\1/p' "$vdf" | sed 's/\\\\/\\/g')
    fi
  done

  local bottle
  for bottle in \
    "$HOME/Library/Application Support/CrossOver/Bottles"/* \
    "$HOME/Library/Containers/com.isaacmarovitz.Whisky/Bottles"/*; do
    [ -d "$bottle" ] && candidates+=("$bottle/drive_c/Program Files (x86)/Steam/steamapps/common/Borderlands 2")
  done
  candidates+=(
    "$HOME/Games/Heroic/Borderlands2"
    "$HOME/Games/borderlands-2"
    "/mnt/c/Program Files (x86)/Steam/steamapps/common/Borderlands 2"
    "/mnt/d/SteamLibrary/steamapps/common/Borderlands 2"
    "/mnt/e/SteamLibrary/steamapps/common/Borderlands 2"
  )

  local c
  for c in "${candidates[@]}"; do
    if is_valid_bl2_dir "$c" && has_pythonsdk_markers "$c"; then
      printf "%s\n" "$c"
      return 0
    fi
  done
  for c in "${candidates[@]}"; do
    if is_valid_bl2_dir "$c"; then
      printf "%s\n" "$c"
      return 0
    fi
  done

  return 1
}

resolve_sdk_mods_dir() {
  local bl2="$1"
  if [ -d "$bl2/sdk_mods" ] || [ ! -d "$bl2/Binaries/Win32/sdk_mods" ]; then
    printf "%s\n" "$bl2/sdk_mods"
  else
    printf "%s\n" "$bl2/Binaries/Win32/sdk_mods"
  fi
}

cmd_setup() {
  info "Setting up local Python virtual environment (.venv)"
  local sys_py="${PYTHON:-python3}"
  command -v "$sys_py" >/dev/null 2>&1 || die "python3 not found."
  if [ ! -d "$REPO_ROOT/.venv" ]; then
    "$sys_py" -m venv "$REPO_ROOT/.venv"
  fi
  "$REPO_ROOT/.venv/bin/python" -m pip install --upgrade pip
  "$REPO_ROOT/.venv/bin/python" -m pip install -r "$REPO_ROOT/requirements.txt"
  ensure_gitignored ".venv/"
  ok "Environment ready at .venv (Pillow installed from requirements.txt)."
}

kit_fingerprint() {
  # Content hash of the kit the UPK compiler reads (prints nothing if it cannot be computed).
  local py
  py="$(pick_python)"
  "$py" "$REPO_ROOT/tools/compile_inkblade_upk.py" --kit "${1:-$DEFAULT_KIT}" --fingerprint-only 2>/dev/null || true
}

compiled_kit_fingerprint() {
  # Fingerprint recorded when the UPKs were compiled.
  local py
  py="$(pick_python)"
  "$py" -c 'import json, sys
try:
    print(json.load(open(sys.argv[1])).get("kit_fingerprint", ""))
except Exception:
    print("")' "$BUILD_MANIFEST" 2>/dev/null || true
}

# Has the kit been repainted since the UPKs were compiled?
#   current - packages match the kit on disk
#   stale   - packages are missing, or were built from a different/unknown kit
#   unknown - cannot tell (no kit, no python): leave the packages on disk alone
upk_kit_state() {
  local meshes_upk="$REPO_ROOT/$COOKED_REL/MeleeArsenalMeshes.upk"
  local tex_upk="$REPO_ROOT/$COOKED_REL/MeleeArsenalTextures.upk"
  if [ ! -f "$meshes_upk" ] || [ ! -f "$tex_upk" ] || [ ! -f "$BUILD_MANIFEST" ]; then
    echo "stale"
    return
  fi
  local want have
  want="$(kit_fingerprint)"
  if [ -z "$want" ]; then
    echo "unknown"
    return
  fi
  have="$(compiled_kit_fingerprint)"
  if [ "$want" = "$have" ]; then
    echo "current"
  else
    echo "stale"
  fi
}

cmd_build() {
  local py
  py="$(pick_python)"
  local has_kit_arg=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      --kit|--kit=*) has_kit_arg=1 ;;
    esac
  done

  local -a extra_args=()
  if [ "$has_kit_arg" -eq 0 ]; then
    if [ ! -f "$DEFAULT_KIT/socket_manifest.json" ]; then
      info "Default kit missing; generating it first"
      cmd_generate
    fi
    extra_args+=(--kit "$DEFAULT_KIT")
  fi

  if ! "$py" -c "import PIL" >/dev/null 2>&1; then
    die "Pillow is not installed for $py. Run './melee setup' first."
  fi

  info "Compiling InkBlade UPK packages & manifest"
  "$py" "$REPO_ROOT/tools/compile_inkblade_upk.py" "${extra_args[@]}" "$@"


}

check() {
  local py
  py="$(pick_python)"
  info "Byte-compiling sdk_mods/ & tools/"
  "$py" -m compileall -q "$REPO_ROOT/sdk_mods" "$REPO_ROOT/tools"
  ok "Syntax check passed."
}

cmd_preview() {
  local py
  py="$(pick_python)"
  "$py" "$REPO_ROOT/tools/preview_arsenal.py" "$@"
}

cmd_package() {
  local do_build=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -b|--build) do_build=1; shift ;;
      *) die "Unknown package flag: $1 (supported: --build)" ;;
    esac
  done

  case "$(upk_kit_state)" in
    stale)
      cmd_build
      ;;
    unknown)
      if [ "$do_build" -eq 1 ]; then
        cmd_build
      else
        warn "Cannot verify the kit fingerprint (no kit/Python). Packaging the existing UPKs; run './melee package --build' to recompile from source."
      fi
      ;;
    current)
      if [ "$do_build" -eq 1 ]; then cmd_build; fi
      ;;
  esac

  local py ver
  py="$(pick_python)"
  ver="$(mod_version)"
  mkdir -p "$REPO_ROOT/build/dist"
  ensure_gitignored "build/"

  info "Building release archives (v$ver) -> build/dist/"
  "$py" - "$REPO_ROOT" "$ver" <<'PY'
from pathlib import Path
import sys
import zipfile

repo = Path(sys.argv[1])
ver = sys.argv[2]
dist = repo / "build" / "dist"

SKIP_DIRS = {"__pycache__", ".git", ".venv", ".pytest_cache", "dist", "assets", "reports"}
SKIP_SUFFIXES = {".pyc", ".pyo", ".pyd", ".log"}

def should_skip(rel_parts: tuple[str, ...], path: Path) -> bool:
    if any(p in SKIP_DIRS or p.startswith(".") for p in rel_parts):
        return True
    if path.name == ".DS_Store" or path.suffix in SKIP_SUFFIXES:
        return True
    return False

mod_zip = dist / "melee_arsenal.zip"
ver_zip = dist / f"melee_arsenal-v{ver}.zip"

meshes_upk = repo / "build" / "WillowGame" / "CookedPCConsole" / "MeleeArsenalMeshes.upk"
tex_upk = repo / "build" / "WillowGame" / "CookedPCConsole" / "MeleeArsenalTextures.upk"
manifest_src = repo / "build" / "inkblade_compiled_manifest.json"
if not meshes_upk.is_file() or not tex_upk.is_file() or not manifest_src.is_file():
    raise SystemExit("Missing cooked UPKs or manifest in build/. Run './melee build' first.")

with zipfile.ZipFile(mod_zip, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as zf:
    zf.write(meshes_upk, "WillowGame/CookedPCConsole/MeleeArsenalMeshes.upk")
    zf.write(tex_upk, "WillowGame/CookedPCConsole/MeleeArsenalTextures.upk")
    zf.write(meshes_upk, "sdk_mods/melee_arsenal/upk/MeleeArsenalMeshes.upk")
    zf.write(tex_upk, "sdk_mods/melee_arsenal/upk/MeleeArsenalTextures.upk")
    zf.write(manifest_src, "sdk_mods/melee_arsenal/data/inkblade_compiled_manifest.json")
    mod_dir = repo / "sdk_mods" / "melee_arsenal"
    for f in sorted(mod_dir.rglob("*")):
        if f.is_file():
            rel = f.relative_to(repo)
            if "upk" in rel.parts or rel.as_posix() == "sdk_mods/melee_arsenal/data/inkblade_compiled_manifest.json":
                continue
            if not should_skip(rel.parts, f):
                zf.write(f, rel.as_posix())

    # Companion SDK-library mods (pure Python, no UPKs).
    for companion in ("re_probe", "melee_re_probe_runner"):
        comp_dir = repo / "sdk_mods" / companion
        if comp_dir.is_dir():
            for f in sorted(comp_dir.rglob("*")):
                if f.is_file():
                    rel = f.relative_to(repo)
                    if not should_skip(rel.parts, f):
                        zf.write(f, rel.as_posix())

ver_zip.write_bytes(mod_zip.read_bytes())

src_zip = dist / "source.zip"
with zipfile.ZipFile(src_zip, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as zs:
    for top in ("README.md", "LICENSE", "requirements.txt", "pyproject.toml", ".gitignore", "melee", "sdk_mods", "tools", "docs"):
        target = repo / top
        if target.is_file():
            zs.write(target, target.name)
        elif target.is_dir():
            for f in sorted(target.rglob("*")):
                if f.is_file():
                    rel = f.relative_to(repo)
                    if "upk" in rel.parts and rel.parts[:2] == ("sdk_mods", "melee_arsenal"):
                        continue
                    if not should_skip(rel.parts, f):
                        zs.write(f, rel.as_posix())

print(f"  melee_arsenal.zip        : {mod_zip.stat().st_size:>10,} bytes")
print(f"  melee_arsenal-v{ver}.zip : {ver_zip.stat().st_size:>10,} bytes")
print(f"  source.zip               : {src_zip.stat().st_size:>10,} bytes")
PY
  ok "Release packages written to $REPO_ROOT/build/dist/"
}

sync_python_mod_dir() {
  local src_dir="$1"
  local dst_dir="$2"
  mkdir -p "$dst_dir"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete \
      --exclude "__pycache__/" \
      --exclude "*.pyc" \
      --exclude "*.pyo" \
      --exclude ".DS_Store" \
      --exclude "melee_arsenal.log" \
      --exclude "reports/" \
      --exclude "upk/" \
      "$src_dir/" "$dst_dir/"
  else
    local py
    py="$(pick_python)"
    "$py" - "$src_dir" "$dst_dir" <<'PY'
from pathlib import Path
import shutil, sys

src = Path(sys.argv[1])
dst = Path(sys.argv[2])
preserve = {"melee_arsenal.log"}

if dst.exists():
    for item in list(dst.iterdir()):
        if item.name in preserve:
            continue
        if item.is_dir():
            shutil.rmtree(item)
        else:
            item.unlink()
dst.mkdir(parents=True, exist_ok=True)

for f in src.rglob("*"):
    rel = f.relative_to(src)
    if "__pycache__" in rel.parts or "reports" in rel.parts or "upk" in rel.parts or f.name == ".DS_Store" or f.suffix in {".pyc", ".pyo"}:
        continue
    out = dst / rel
    if f.is_dir():
        out.mkdir(parents=True, exist_ok=True)
    else:
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(f, out)
PY
  fi
}

cmd_install() {
  local bl2_arg=""
  local no_rebuild=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bl2-dir)   [ "$#" -ge 2 ] || die "--bl2-dir requires a path argument."; bl2_arg="$2"; shift 2 ;;
      --bl2-dir=*) bl2_arg="${1#*=}"; shift ;;
      --no-rebuild) no_rebuild=1; shift ;;
      *)           die "Unknown install flag: $1 (supported: --bl2-dir <path>, --no-rebuild)" ;;
    esac
  done

  local bl2
  bl2="$(detect_bl2_dir "$bl2_arg")" || die "Could not auto-detect Borderlands 2 directory. Pass --bl2-dir \"/path/to/Borderlands 2\" (saved to .bl2_dir) or export BL2_DIR."

  local meshes_upk="$REPO_ROOT/$COOKED_REL/MeleeArsenalMeshes.upk"
  local tex_upk="$REPO_ROOT/$COOKED_REL/MeleeArsenalTextures.upk"
  # Rebuild the packages when their recorded kit fingerprint differs from the current kit.
  if [ ! -f "$meshes_upk" ] || [ ! -f "$tex_upk" ] || [ ! -f "$BUILD_MANIFEST" ]; then
    die "Missing cooked UPKs or manifest in $COOKED_REL. Run './melee build' first (or drop --no-rebuild)."
  fi
  if [ "$no_rebuild" -eq 1 ]; then
    if [ "$(upk_kit_state)" = "stale" ]; then
      warn "Installing packages that do not match the kit on disk (--no-rebuild) — the game will show the old textures."
    fi
  else
    case "$(upk_kit_state)" in
      stale)
        if [ ! -f "$meshes_upk" ] || [ ! -f "$tex_upk" ] || [ ! -f "$BUILD_MANIFEST" ]; then
          warn "Cooked UPKs missing in $COOKED_REL — building first..."
        else
          info "Kit changed since the last UPK build — recompiling the packages"
        fi
        cmd_build
        ;;
    esac
  fi

  local sdk_dir
  sdk_dir="$(resolve_sdk_mods_dir "$bl2")"
  local cooked_dst="$bl2/WillowGame/CookedPCConsole"

  info "Installing Melee Arsenal + companion SDK mods v$(mod_version) -> $bl2"
  mkdir -p "$cooked_dst" "$sdk_dir"

  # --- melee-arsenal (has cooked UPKs) -------------------------------------
  cp -f "$meshes_upk" "$cooked_dst/MeleeArsenalMeshes.upk"
  cp -f "$tex_upk" "$cooked_dst/MeleeArsenalTextures.upk"
  ok "Staged UPKs -> $cooked_dst/"

  sync_python_mod_dir "$REPO_ROOT/$MOD_REL" "$sdk_dir/melee_arsenal"
  mkdir -p "$sdk_dir/melee_arsenal/upk" "$sdk_dir/melee_arsenal/data"
  cp -f "$meshes_upk" "$sdk_dir/melee_arsenal/upk/MeleeArsenalMeshes.upk"
  cp -f "$tex_upk" "$sdk_dir/melee_arsenal/upk/MeleeArsenalTextures.upk"
  cp -f "$BUILD_MANIFEST" "$sdk_dir/melee_arsenal/data/inkblade_compiled_manifest.json"
  ok "Synced mod -> $sdk_dir/melee_arsenal/ (sidecar saves in _melee_arsenal_saves preserved)"

  # --- companion SDK-library mods (pure Python, no UPKs) -------------------
  for companion_mod in re_probe melee_re_probe_runner; do
    sync_python_mod_dir "$REPO_ROOT/sdk_mods/$companion_mod" "$sdk_dir/$companion_mod"
  done
  ok "Synced companion mods -> $sdk_dir/re_probe/ and $sdk_dir/melee_re_probe_runner/"

}

cmd_uninstall() {
  local bl2_arg=""
  local purge_saves=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bl2-dir)     [ "$#" -ge 2 ] || die "--bl2-dir requires a path argument."; bl2_arg="$2"; shift 2 ;;
      --bl2-dir=*)   bl2_arg="${1#*=}"; shift ;;
      --purge-saves) purge_saves=1; shift ;;
      *)             die "Unknown uninstall flag: $1 (supported: --bl2-dir <path>, --purge-saves)" ;;
    esac
  done

  local bl2
  bl2="$(detect_bl2_dir "$bl2_arg")" || die "Could not auto-detect Borderlands 2 directory. Pass --bl2-dir \"/path/to/Borderlands 2\"."
  local sdk_dir
  sdk_dir="$(resolve_sdk_mods_dir "$bl2")"
  local cooked_dst="$bl2/WillowGame/CookedPCConsole"

  info "Uninstalling Melee Arsenal + companion SDK mods from $bl2"
  rm -rf "$sdk_dir/melee_arsenal" "$sdk_dir/re_probe" "$sdk_dir/melee_re_probe_runner"
  rm -f "$cooked_dst/MeleeArsenalMeshes.upk" "$cooked_dst/MeleeArsenalTextures.upk"
  if [ "$purge_saves" -eq 1 ]; then
    rm -rf "$sdk_dir/_melee_arsenal_saves"
    rm -f "$sdk_dir/settings/melee_arsenal.json"
    ok "Removed mod, UPKs, sidecar saves, and settings."
  else
    ok "Removed mod & UPKs (preserved $sdk_dir/_melee_arsenal_saves)."
  fi
}

cmd_logs() {
  local follow=0
  local lines=80
  local bl2_arg=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      -n|--lines)  [ "$#" -ge 2 ] || die "-n requires a line count."; lines="$2"; shift 2 ;;
      --bl2-dir)   [ "$#" -ge 2 ] || die "--bl2-dir requires a path."; bl2_arg="$2"; shift 2 ;;
      --bl2-dir=*) bl2_arg="${1#*=}"; shift ;;
      *)           die "Unknown logs flag: $1 (supported: -f/--follow, -n <lines>, --bl2-dir <path>)" ;;
    esac
  done

  local bl2
  bl2="$(detect_bl2_dir "$bl2_arg")" || die "Could not auto-detect Borderlands 2 directory. Pass --bl2-dir \"/path/to/Borderlands 2\"."
  local sdk_dir
  sdk_dir="$(resolve_sdk_mods_dir "$bl2")"
  local log_file="$sdk_dir/melee_arsenal/melee_arsenal.log"

  [ -f "$log_file" ] || die "Log file not created yet: $log_file"
  info "Log: $log_file"
  if [ "$follow" -eq 1 ]; then
    tail -n "$lines" -f "$log_file"
  else
    tail -n "$lines" "$log_file"
  fi
}

cmd_status() {
  local py ver
  py="$(pick_python)"
  ver="$(mod_version)"
  local pil_state="missing (run ./melee setup)"
  if "$py" -c "import PIL; print(PIL.__version__)" >/dev/null 2>&1; then
    pil_state="installed ($("$py" -c "import PIL; print(PIL.__version__)"))"
  fi

  info "Melee Arsenal Repository Status"
  printf "  Repo root       : %s\n" "$REPO_ROOT"
  printf "  Mod version     : v%s\n" "$ver"
  printf "  Python          : %s (%s)\n" "$py" "$("$py" -V 2>&1)"
  printf "  Pillow (UPK)    : %s\n" "$pil_state"

  if [ -f "$DEFAULT_KIT/socket_manifest.json" ]; then
    printf "  InkBlade kit    : %s✓%s %s\n" "$C_GREEN" "$C_RESET" "$DEFAULT_KIT"
  else
    printf "  InkBlade kit    : %s✗ missing%s (%s)\n" "$C_YELLOW" "$C_RESET" "$DEFAULT_KIT"
  fi

  local manifest="$BUILD_MANIFEST"
  if [ -f "$manifest" ]; then
    local rev
    rev="$("$py" -c "import json,sys; d=json.load(open(sys.argv[1])); print(f\"{d.get('kit_revision','?')} ({len(d.get('fragments',[]))} fragments)\")" "$manifest")"
    printf "  Manifest        : %s\n" "$rev"
  fi

  local m_upk="$REPO_ROOT/$COOKED_REL/MeleeArsenalMeshes.upk"
  local t_upk="$REPO_ROOT/$COOKED_REL/MeleeArsenalTextures.upk"
  if [ -f "$m_upk" ] && [ -f "$t_upk" ]; then
    printf "  Cooked UPKs     : %s✓%s Meshes (%s B), Textures (%s B)\n" \
      "$C_GREEN" "$C_RESET" "$(wc -c < "$m_upk" | tr -d ' ')" "$(wc -c < "$t_upk" | tr -d ' ')"
    if [ "$(upk_kit_state)" = "stale" ]; then
      printf "                    %s! built from an older kit — run ./melee build to recompile%s\n" \
        "$C_YELLOW" "$C_RESET"
    fi
  else
    printf "  Cooked UPKs     : %s✗ not built%s (run ./melee build)\n" "$C_YELLOW" "$C_RESET"
  fi

  local bl2=""
  if bl2="$(detect_bl2_dir "${1:-}" 2>/dev/null)"; then
    local sdk_dir
    sdk_dir="$(resolve_sdk_mods_dir "$bl2")"
    printf "  BL2 install     : %s✓%s %s\n" "$C_GREEN" "$C_RESET" "$bl2"
    if [ -d "$sdk_dir/melee_arsenal" ] || [ -f "$bl2/WillowGame/CookedPCConsole/MeleeArsenalTextures.upk" ]; then
      local sync_json
      if sync_json="$("$py" "$REPO_ROOT/tools/check_install_sync.py" --repo "$REPO_ROOT" --sdk-dir "$sdk_dir" --cooked-dir "$bl2/WillowGame/CookedPCConsole" 2>/dev/null)"; then
        printf "  Installed state : %s✓ installed & in sync (full payload hash)%s\n" "$C_GREEN" "$C_RESET"
      else
        local sync_detail
        sync_detail="$("$py" -c 'import json,sys; d=json.loads(sys.argv[1]); print(f"{len(d.get(\"missing\",[]))} missing, {len(d.get(\"different\",[]))} different of {d.get(\"checked\",0)} files")' "$sync_json" 2>/dev/null || echo "partial payload")"
        printf "  Installed state : %s! installed (out of sync — %s; run ./melee install)%s\n" "$C_YELLOW" "$sync_detail" "$C_RESET"
      fi
    else
      printf "  Installed state : not installed (run ./melee install)\n"
    fi
    if [ -d "$sdk_dir/_melee_arsenal_saves" ]; then
      local save_cnt
      save_cnt="$(find "$sdk_dir/_melee_arsenal_saves" -maxdepth 1 -name '*.json' | wc -l | tr -d ' ')"
      printf "  Sidecar saves   : %s save file(s) in _melee_arsenal_saves\n" "$save_cnt"
    fi

    # Companion SDK-library mods (pure Python, no UPKs).
    for companion_mod in re_probe melee_re_probe_runner; do
      if [ -d "$sdk_dir/$companion_mod" ]; then
        printf "  %-20s : %s✓ installed%s (pure Python mod)\n" "$companion_mod" "$C_GREEN" "$C_RESET"
      else
        printf "  %-20s : %s✗ not installed%s (run ./melee install)\n" "$companion_mod" "$C_YELLOW" "$C_RESET"
      fi
    done
  else
    printf "  BL2 install     : %snot auto-detected%s (pass --bl2-dir <path> to ./melee install)\n" "$C_DIM" "$C_RESET"
  fi
}

cmd_clean() {
  info "Cleaning bytecode caches & build artifacts"
  find "$REPO_ROOT" \( -name "__pycache__" -o -name ".pytest_cache" \) -type d -prune -exec rm -rf {} +
  find "$REPO_ROOT" \( -name "*.pyc" -o -name "*.pyo" -o -name ".DS_Store" \) -type f -delete
  rm -rf "$REPO_ROOT/build"
  ok "Workspace cleaned."
}

cmd_dev() {
  check
  cmd_install "$@"
}

cmd_all() {
  cmd_build
  check
  cmd_package
  if detect_bl2_dir "" >/dev/null 2>&1; then
    cmd_install "$@"
  else
    warn "Skipping install step (BL2 directory not configured yet; run './melee install --bl2-dir <path>')."
  fi
}

cmd_generate() {
  local py
  py="$(pick_python)"
  case "${1:-}" in
    --list-stages) ;;
    *)
      if ! "$py" -c "import PIL" >/dev/null 2>&1; then
        die "Pillow is not installed for $py. Run './melee setup' first."
      fi
      info "Generating InkBlade kit through the staged pipeline"
      ;;
  esac
  "$py" "$REPO_ROOT/tools/generate_inkblade_kit.py" "$@"
  if [ "$(upk_kit_state)" = "stale" ]; then
    warn "Kit regenerated — run './melee build' (or './melee dev') to recompile the UPKs the game loads."
  fi
}

cmd_help() {
  cat <<USAGE
${C_BOLD}melee${C_RESET} — Melee Arsenal CLI (v$(mod_version))

${C_BOLD}Usage:${C_RESET}
  ./melee <command> [options]

${C_BOLD}Commands:${C_RESET}
  ${C_CYAN}setup${C_RESET}                     Create .venv and install Pillow for UPK compilation
  ${C_CYAN}build${C_RESET} [--kit <path>]      Compile InkBlade kit -> build/ UPKs + manifest JSON
                            (generates ./build/inkblade_kit automatically if absent)
  ${C_CYAN}generate${C_RESET} [options]        Regenerate the InkBlade kit (stages: geometry -> uv -> flat ->
                            mottle -> detail -> decals -> linework -> textures -> export)
                            Options: --list-stages, --only <s>, --from <s>, --force <s>,
                                     --no-decals-art, --decals <dir>, --out <dir|zip>, --parts <ids>,
                                     --no-combinations, --renders [dir] (default build/inkblade_renders)
  ${C_CYAN}check${C_RESET}                     Byte-compile every module (syntax check)
  ${C_CYAN}preview${C_RESET}                   Roll & print sample Level 50 Melee Arsenal item cards & hit math
  ${C_CYAN}package${C_RESET} [--build]         Build release archives in build/dist/
                            (recompiles the UPKs first if the kit has changed since the last build)
  ${C_CYAN}install${C_RESET} [options]         Install melee-arsenal + companion SDK mods
                            (re_probe, melee_re_probe_runner) into Borderlands 2
                            Recompiles the UPKs automatically when the kit has been regenerated.
                            Options: --bl2-dir <path> (cached in .bl2_dir), --no-rebuild
  ${C_CYAN}dev${C_RESET} [install-options]     Quick iterate: syntax check, then install to Borderlands 2
                            (safe after './melee generate': stale UPKs are recompiled, not shipped)
  ${C_CYAN}uninstall${C_RESET} [options]       Remove mod & UPKs from Borderlands 2 (--purge-saves to wipe saves)
  ${C_CYAN}status${C_RESET}                    Show repo, kit, UPK, Borderlands 2 sync, and sidecar save status
  ${C_CYAN}logs${C_RESET} [-f] [-n <lines>]    View or follow live in-game melee_arsenal.log
  ${C_CYAN}clean${C_RESET}                     Remove __pycache__, .pyc, and build/
  ${C_CYAN}all${C_RESET} [install-options]     Full pipeline: build -> test -> package -> install (if BL2 found)

${C_BOLD}Environment:${C_RESET}
  BL2_DIR                   Path to 'Borderlands 2' folder (or pass --bl2-dir once to cache in .bl2_dir)
  PYTHON                    Override Python interpreter (defaults to .venv/bin/python or python3)
USAGE
}

main() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    setup)                 cmd_setup "$@" ;;
    generate)              cmd_generate "$@" ;;
    build)                 cmd_build "$@" ;;
    check)                 check ;;
    preview)               cmd_preview "$@" ;;
    package)               cmd_package "$@" ;;
    install)               cmd_install "$@" ;;
    dev)                   cmd_dev "$@" ;;
    uninstall)             cmd_uninstall "$@" ;;
    status)                cmd_status "$@" ;;
    logs)                  cmd_logs "$@" ;;
    clean)                 cmd_clean "$@" ;;
    all)                   cmd_all "$@" ;;
    -h|--help|help)        cmd_help ;;
    *)                     die "Unknown command '$sub'. Run './melee help' for usage." ;;
  esac
}

main "$@"
